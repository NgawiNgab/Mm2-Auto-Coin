local EMOTE_ASSET_ID = "126179639449048"
local REPLAY_INTERVAL = 1

local requestFn = request or http_request or (syn and syn.request) or (http and http.request)

local function httpGet(url)
    if requestFn then
        local ok, response = pcall(requestFn, {
            Url = url,
            Method = "GET"
        })
        if ok and type(response) == "table" and response.Body and (response.Success or response.StatusCode == 200) then
            return response.Body
        end
    end
    return game:HttpGet(url)
end

local function resolveEmote(assetId)
    local animationId
    local ok, objects = pcall(function()
        return game:GetObjects("rbxassetid://" .. assetId)
    end)
    local root = ok and objects and objects[1]

    if root then
        if root:IsA("Animation") then
            animationId = root.AnimationId
        else
            local animation = root:FindFirstChildWhichIsA("Animation", true)
            animationId = animation and animation.AnimationId
        end
    end

    if not animationId or animationId == "" then
        local delivery = HttpService:JSONDecode(
            httpGet("https://assetdelivery.roblox.com/v1/assetId/" .. assetId)
        )
        if delivery.location then
            animationId = string.match(
                httpGet(delivery.location),
                "rbxassetid://%d+"
            )
        end
    end

    assert(animationId and animationId ~= "", "Gagal menemukan Animation ID")
    return animationId
end

local emoteSuccess, resolvedAnimationId = pcall(resolveEmote, EMOTE_ASSET_ID)
if not emoteSuccess then
    warn("Epic Emote gagal di-resolve:", resolvedAnimationId)
end

local emoteRunning = false
local currentEmoteTrack = nil
local currentEmoteCharacter = nil
local emoteThread = nil

local function StartEmote()
    if not resolvedAnimationId or emoteRunning then return end
    emoteRunning = true

    emoteThread = task.spawn(function()
        local animation = Instance.new("Animation")
        animation.AnimationId = resolvedAnimationId

        while emoteRunning do
            local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

            if character ~= currentEmoteCharacter then
                if currentEmoteTrack then
                    currentEmoteTrack:Stop(0)
                    currentEmoteTrack:Destroy()
                    currentEmoteTrack = nil
                end

                currentEmoteCharacter = character
                local humanoid = character:WaitForChild("Humanoid")
                local animator = humanoid:WaitForChild("Animator")

                local ok, result = pcall(function()
                    return animator:LoadAnimation(animation)
                end)

                if ok then
                    currentEmoteTrack = result
                    currentEmoteTrack.Priority = Enum.AnimationPriority.Action
                end
            end

            if currentEmoteTrack and emoteRunning then
                currentEmoteTrack:Play(0)
            end

            local waited = 0
            while waited < REPLAY_INTERVAL and emoteRunning do
                task.wait(0.1)
                waited = waited + 0.1
            end

            if currentEmoteTrack and currentEmoteTrack.IsPlaying and emoteRunning then
                currentEmoteTrack:Stop(0)
            end
        end

        if currentEmoteTrack then
            currentEmoteTrack:Stop(0)
            currentEmoteTrack:Destroy()
            currentEmoteTrack = nil
        end
        currentEmoteCharacter = nil
        animation:Destroy()
    end)
end

local function StopEmote()
    emoteRunning = false
    if currentEmoteTrack then
        currentEmoteTrack:Stop(0)
        currentEmoteTrack:Destroy()
        currentEmoteTrack = nil
    end
    currentEmoteCharacter = nil
end

